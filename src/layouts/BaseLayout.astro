---
import '../styles/global.css';
const { title = '拾光誌｜在日常裡拾起值得記錄的光', description = '一個記錄生活、閱讀、工作與創作的個人部落格。' } = Astro.props;
---
<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <base href={import.meta.env.BASE_URL} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f7f2" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="/">拾光誌</a>
        <nav class="nav" aria-label="主要導覽">
          <a href="/">首頁</a><a href="/blog/">所有文章</a><a href="/news/">每日新聞</a><a href="/about/">關於</a><a href="/contact/">聯絡</a>
        </nav>
      </div>
    </header>
    <slot />
    <script is:inline>
      (() => {
        const base = '/Repository';
        document.querySelectorAll('a[href^="/"]').forEach((link) => {
          const href = link.getAttribute('href');
          if (href && !href.startsWith(base + '/') && href !== base) {
            link.setAttribute('href', base + href);
          }
        });
      })();
    </script>
    <script is:inline type="module" define:vars={{ basePath: import.meta.env.BASE_URL }}>
      import { createClient } from 'https://esm.sh/@supabase/supabase-js@2.57.0';
      const supabase = createClient('https://aaynitbvfhxttrmlmvlf.supabase.co', 'sb_publishable_NboWNFpuMgsFAP0j-_3keg_jQIGLI2a', {
        auth: { persistSession: true, autoRefreshToken: true, detectSessionInUrl: true }
      });
      const root = basePath.replace(/\\/$/, '');
      const path = location.pathname.replace(/\\/$/, '') || '/';
      const loginPath = root + '/admin/login';
      const isAdminPage = path === root + '/admin' || path.startsWith(root + '/admin/');
      const isLoginPage = path === loginPath || path === loginPath + '/';

      if (isAdminPage && !isLoginPage) {
        const { data: { session } } = await supabase.auth.getSession();
        if (!session) {
          location.replace(loginPath + '/?next=' + encodeURIComponent(path + '/'));
        } else {
          const { data: admin, error } = await supabase
            .from('blog_admins').select('user_id')
            .eq('user_id', session.user.id).maybeSingle();
          if (error || !admin) {
            await supabase.auth.signOut();
            location.replace(loginPath + '/?error=not_admin');
          }
        }
      }

      document.querySelectorAll('[data-admin-logout]').forEach((button) => {
        button.addEventListener('click', async () => {
          button.disabled = true;
          const { error } = await supabase.auth.signOut();
          if (error) {
            button.disabled = false;
            alert('登出失敗：' + error.message);
            return;
          }
          location.replace(loginPath + '/');
        });
      });
    </script>
    <footer class="site-footer"><div class="container">© 2026 拾光誌 · 在日常裡拾起值得記錄的光</div></footer>
  </body>
</html>