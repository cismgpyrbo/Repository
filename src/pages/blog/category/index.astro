---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---
<BaseLayout title="文章分類｜拾光誌">
  <main class="container">
    <header class="page-intro"><div class="eyebrow">CATEGORY</div><h1 id="category-title">文章分類</h1><p class="muted">這個主題下的所有已發布文章。</p></header>
    <div class="post-grid" id="category-posts"><p class="muted">正在載入文章…</p></div>
    <p id="category-status" class="muted" role="status"></p>
  </main>
  <script is:inline type="module">
    import { createClient } from 'https://esm.sh/@supabase/supabase-js@2.119.2';
    const db=createClient('https://aaynitbvfhxttrmlmvlf.supabase.co','sb_publishable_NboWNFpuMgsFAP0j-_3keg_jQIGLI2a');
    const slug=new URLSearchParams(location.search).get('slug');
    const root=document.querySelector('#category-posts');
    const siteBase=(document.querySelector('base')?.getAttribute('href')||'/').replace(/\/?$/,'/');\n    const imgUrl=path=>path?'https://aaynitbvfhxttrmlmvlf.supabase.co/storage/v1/object/public/blog-media/'+path.split('/').map(encodeURIComponent).join('/'):'https://images.unsplash.com/photo-1449247709967-d4461a6a6103?auto=format&fit=crop&w=1000&q=80';
    try{
      if(!slug)throw new Error('缺少分類網址代稱。');
      const {data:category,error}=await db.from('blog_categories').select('id,name').eq('slug',slug).eq('is_active',true).maybeSingle();
      if(error)throw error;if(!category)throw new Error('找不到這個分類。');
      document.querySelector('#category-title').textContent=category.name;document.title=category.name+'｜拾光誌';
      const [p,m]=await Promise.all([
        db.from('blog_posts').select('id,title,slug,excerpt,cover_image_id,published_at').eq('category_id',category.id).eq('status','published').not('published_at','is',null).order('published_at',{ascending:false}),
        db.from('blog_media').select('id,storage_path').eq('status','active')
      ]);
      if(p.error)throw p.error;if(m.error)throw m.error;
      const media=new Map((m.data||[]).map(x=>[x.id,imgUrl(x.storage_path)]));root.replaceChildren();
      (p.data||[]).forEach(post=>{
        const card=document.createElement('article');card.className='post-card';
        const a=document.createElement('a');a.href=siteBase+'blog/article/?slug='+encodeURIComponent(post.slug);
        const img=document.createElement('img');img.src=media.get(post.cover_image_id)||imgUrl(null);img.alt=post.title;img.loading='lazy';a.append(img);
        const h=document.createElement('h3');const link=document.createElement('a');link.href=a.href;link.textContent=post.title;h.append(link);
        const meta=document.createElement('div');meta.className='meta';meta.textContent=post.published_at?new Date(post.published_at).toLocaleDateString('zh-TW'):'';
        const ex=document.createElement('p');ex.className='excerpt';ex.textContent=post.excerpt;card.append(a,h,meta,ex);root.append(card);
      });
      if(!root.children.length)root.textContent='此分類目前沒有已發布文章。';
    }catch(e){root.textContent=e.message||'分類文章載入失敗。';}
  </script>
</BaseLayout>