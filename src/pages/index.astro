---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { posts, categories } from '../data/posts';
const featured = posts.find((p) => p.featured) ?? posts[0];
const latest = posts.filter((p) => p.slug !== featured.slug);
---
<BaseLayout>
  <main class="container">
    <section class="hero">
      <div><div class="eyebrow">A JOURNAL OF EVERYDAY MOMENTS</div><h1>在日常裡，<br/>拾起值得記錄的光。</h1><p>這裡記錄生活的觀察、閱讀的收穫，以及工作與創作途中那些值得留下的想法。</p><a class="button" href="/blog/">開始閱讀　→</a></div>
      <img class="hero-image" src="https://images.unsplash.com/photo-1441986300917-64674bd600d8?auto=format&fit=crop&w=1400&q=85" alt="午後陽光灑落在安靜的室內空間" />
    </section>
    <section class="section">
      <div class="section-heading"><div><div class="eyebrow">EDITOR'S PICK</div><h2>本期選讀</h2></div><a class="text-link" href="/blog/">探索全部文章 →</a></div>
      <article class="featured">
        <a href={`/blog/${featured.slug}/`}><img src={featured.cover} alt="" /></a>
        <div class="featured-copy"><div class="eyebrow">{featured.category}</div><h3><a href={`/blog/${featured.slug}/`}>{featured.title}</a></h3><div class="meta"><span>{featured.date}</span><span>{featured.readTime}</span></div><p class="excerpt">{featured.excerpt}</p><a class="text-link" href={`/blog/${featured.slug}/`}>閱讀文章 →</a></div>
      </article>
    </section>
    <section class="section">
      <div class="section-heading"><div><div class="eyebrow">RECENT STORIES</div><h2>最近更新</h2></div><a class="text-link" href="/blog/">所有文章 →</a></div>
      <div class="post-grid">{latest.slice(0,3).map((post) => <PostCard post={post} />)}</div>
    </section>
    <section class="section"><div class="section-heading"><div><div class="eyebrow">EXPLORE TOPICS</div><h2>依主題閱讀</h2></div></div><div class="category-list">{categories.map((category) => <a class="category-chip" href={`/category/${encodeURIComponent(category)}/`}>{category}　↗</a>)}</div></section>
  </main>
</BaseLayout>