---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { newsArticles } from '../../data/news';
export function getStaticPaths() {
  return newsArticles.map((item) => ({ params: { slug: item.slug }, props: { item } }));
}
const { item } = Astro.props;
---
<BaseLayout title={`${item.title}｜每日新聞｜拾光誌`} description={item.summary}>
  <main class="container">
    <article class="article">
      <a class="text-link" href="/news/">← 返回每日新聞</a>
      <div class="eyebrow" style="margin-top:30px">{item.category} · 每日新聞整理</div>
      <h1>{item.title}</h1>
      <div class="meta"><span>新聞日期：{item.newsDate}</span><span>整理發布：{item.publishedAt}</span></div>
      <div class="admin-panel" style="margin:28px 0">
        <div class="eyebrow">SUMMARY</div>
        <p class="excerpt">{item.summary}</p>
      </div>
      <div class="article-body">{item.content.map((paragraph) => <p>{paragraph}</p>)}</div>
      <div style="border-top:1px solid var(--line);padding-top:25px;margin-top:45px">
        <div class="eyebrow">ORIGINAL SOURCE</div>
        <p class="muted">新聞來源：{item.sourceName}</p>
        <a class="button" href={item.sourceUrl} target="_blank" rel="noopener noreferrer">前往原始新聞 →</a>
      </div>
      <p class="muted" style="font-size:12px;margin-top:30px">本文為新聞整理內容，請以原始新聞來源及其後續更新為準。</p>
    </article>
  </main>
</BaseLayout>
