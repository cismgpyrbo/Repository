---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import AdminNav from '../../../../components/AdminNav.astro';
const supabaseUrl = 'https://aaynitbvfhxttrmlmvlf.supabase.co';
const publishableKey = 'sb_publishable_NboWNFpuMgsFAP0j-_3keg_jQIGLI2a';
---
<BaseLayout title="編輯新聞｜拾光誌">
  <main class="container admin-shell">
    <AdminNav />
    <div class="eyebrow">NEWS EDITOR</div>
    <div class="section-heading admin-page-heading"><h1 class="serif" id="editor-heading">新增新聞</h1><a class="category-chip" href="/admin/">返回管理後台</a></div>
    <p class="muted">新增內容預設儲存為草稿；編輯已發布新聞時，儲存會保留原發布狀態。所有異動由資料庫自動寫入操作紀錄。</p>
    <form id="news-form" class="admin-panel" style="display:grid;gap:16px">
      <label>新聞標題<input id="title" required maxlength="300" style="display:block;width:100%;margin-top:6px;padding:12px;border:1px solid var(--line)"></label>
      <div class="admin-stats" style="grid-template-columns:repeat(auto-fit,minmax(180px,1fr))">
        <label>新聞日期<input id="news-date" type="date" required style="display:block;width:100%;margin-top:6px;padding:12px;border:1px solid var(--line)"></label>
        <label>分類<input id="category" required value="科技" style="display:block;width:100%;margin-top:6px;padding:12px;border:1px solid var(--line)"></label>
        <label>內容類型<select id="content-type" style="display:block;width:100%;margin-top:6px;padding:12px;border:1px solid var(--line)"><option value="article">單則新聞</option><option value="daily_briefing">每日新聞摘要</option></select></label>
      </div>
      <label>網址代稱（Slug）<input id="slug" required pattern="[a-z0-9]+(?:-[a-z0-9]+)*" placeholder="example-news-title" style="display:block;width:100%;margin-top:6px;padding:12px;border:1px solid var(--line)"><small class="muted">僅使用小寫英文字母、數字及連字號；發布後修改會改變文章網址。</small></label>
      <label>新聞來源名稱<input id="source-name" required style="display:block;width:100%;margin-top:6px;padding:12px;border:1px solid var(--line)"></label>
      <label>原始新聞網址<input id="source-url" type="url" required placeholder="https://" style="display:block;width:100%;margin-top:6px;padding:12px;border:1px solid var(--line)"></label>
      <label>新聞摘要<textarea id="summary" rows="3" required style="display:block;width:100%;margin-top:6px;padding:12px;border:1px solid var(--line)"></textarea></label>
      <label>詳細內容（支援 Markdown）<textarea id="content" rows="16" required style="display:block;width:100%;margin-top:6px;padding:12px;border:1px solid var(--line);line-height:1.8"></textarea></label>
      <label>關鍵字（以逗號分隔）<input id="keywords" placeholder="AI,科技,產業" style="display:block;width:100%;margin-top:6px;padding:12px;border:1px solid var(--line)"></label>
      <label style="display:flex;gap:8px;align-items:center"><input id="featured" type="checkbox"> 設為精選新聞</label>
      <div class="row" style="display:flex;gap:12px;flex-wrap:wrap">
        <button class="button" type="submit" id="save-button">儲存草稿</button>
        <button class="category-chip" type="button" id="save-publish">儲存並發布</button>
        <a class="category-chip" href="/admin/news/">取消</a>
      </div>
      <p id="editor-status" class="muted" role="status" aria-live="polite"></p>
    </form>
  </main>
</BaseLayout>
<script is:inline type="module" define:vars={{ supabaseUrl, publishableKey, basePath: import.meta.env.BASE_URL }}>
  import { createClient } from 'https://esm.sh/@supabase/supabase-js@2.57.0';
  const supabase = createClient(supabaseUrl, publishableKey);
  const $ = (id) => document.getElementById(id);
  const params = new URLSearchParams(location.search);
  const recordId = params.get('id');
  const isNew = params.get('new') === '1' || !recordId;
  const statusNode = $('editor-status');
  let existing = null;
  const today = new Date();
  $('news-date').value = new Date(today.getTime() - today.getTimezoneOffset() * 60000).toISOString().slice(0,10);

  async function verifyAdmin() {
    const { data: userData, error: userError } = await supabase.auth.getUser();
    if (userError || !userData?.user) throw new Error('登入狀態已失效，請重新登入。');
    const { data: admin, error } = await supabase.from('blog_admins').select('user_id').eq('user_id', userData.user.id).maybeSingle();
    if (error) throw error;
    if (!admin) throw new Error('目前帳號不在網站管理者名單內。');
  }

  function fill(item) {
    $('title').value = item.title || '';
    $('news-date').value = item.news_date || $('news-date').value;
    $('category').value = item.category || '';
    $('content-type').value = item.content_type || 'article';
    $('slug').value = item.slug || '';
    $('source-name').value = item.source_name || '';
    $('source-url').value = item.source_url || '';
    $('summary').value = item.summary || '';
    $('content').value = item.content || '';
    $('keywords').value = (item.keywords || []).join(', ');
    $('featured').checked = !!item.is_featured;
  }

  function slugify(value) {
    return value.toLowerCase().normalize('NFKD').replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
  }
  $('title').addEventListener('input', () => {
    if (isNew && !$('slug').dataset.touched) $('slug').value = slugify($('title').value);
  });
  $('slug').addEventListener('input', () => $('slug').dataset.touched = '1');

  async function save(nextStatus) {
    const title = $('title').value.trim();
    const slug = slugify($('slug').value);
    const sourceUrl = $('source-url').value.trim();
    if (!title || !slug || !$('news-date').value || !$('category').value.trim() || !$('source-name').value.trim() || !sourceUrl || !$('summary').value.trim() || !$('content').value.trim()) {
      statusNode.textContent = '請完整填寫標題、日期、分類、來源、來源網址、摘要及詳細內容。';
      return;
    }
    let parsed;
    try { parsed = new URL(sourceUrl); } catch { statusNode.textContent = '來源網址格式不正確。'; return; }
    if (parsed.protocol !== 'https:') { statusNode.textContent = '來源網址必須使用 HTTPS。'; return; }
    const payload = {
      title, slug, news_date: $('news-date').value, category: $('category').value.trim(),
      content_type: $('content-type').value, source_name: $('source-name').value.trim(),
      source_url: sourceUrl, summary: $('summary').value.trim(), content: $('content').value.trim(),
      keywords: $('keywords').value.split(/[,，、]/).map(x => x.trim()).filter(Boolean),
      is_featured: $('featured').checked,
      status: nextStatus,
      published_at: nextStatus === 'published' ? (existing?.published_at || new Date().toISOString()) : null
    };
    $('save-button').disabled = true;
    $('save-publish').disabled = true;
    statusNode.textContent = '正在儲存…';
    try {
      let query;
      if (existing) query = supabase.from('blog_news_articles').update(payload).eq('id', existing.id).select('id').maybeSingle();
      else query = supabase.from('blog_news_articles').insert(payload).select('id').single();
      const { data, error } = await query;
      if (error) throw error;
      if (!data) throw new Error('資料未更新，請確認管理者權限。');
      statusNode.textContent = nextStatus === 'published' ? '已成功儲存並發布。' : '已成功儲存為草稿。';
      const base = basePath.endsWith('/') ? basePath : basePath + '/';
      const link = document.createElement('a');
      link.className = 'text-link';
      link.href = base + 'admin/news/';
      link.textContent = '返回新聞管理 →';
      statusNode.append(document.createElement('br'), link);
      if (!existing) {
        existing = { id: data.id, published_at: payload.published_at, status: nextStatus };
        history.replaceState({}, '', location.pathname + '?id=' + encodeURIComponent(data.id));
        $('editor-heading').textContent = '編輯新聞';
      } else { existing.status = nextStatus; if (payload.status === 'published') existing.published_at = payload.published_at; }
    } catch (error) {
      statusNode.textContent = '儲存失敗：' + (error?.message || '未知錯誤');
    } finally {
      $('save-button').disabled = false;
      $('save-publish').disabled = false;
    }
  }

  $('news-form').addEventListener('submit', (event) => { event.preventDefault(); save(existing?.status || 'draft'); });
  $('save-publish').addEventListener('click', () => {
    if (confirm('確定儲存並立即發布這則新聞？')) save('published');
  });

  try {
    await verifyAdmin();
    if (!isNew) {
      const { data, error } = await supabase.from('blog_news_articles').select('*').eq('id', recordId).maybeSingle();
      if (error) throw error;
      if (!data) throw new Error('找不到這則新聞。');
      existing = data;
      fill(data);
      $('editor-heading').textContent = '編輯新聞';
      $('save-button').textContent = '儲存修改';
    }
  } catch (error) {
    statusNode.textContent = '無法開啟編輯器：' + (error?.message || '未知錯誤');
    $('save-button').disabled = true;
    $('save-publish').disabled = true;
  }
</script>
