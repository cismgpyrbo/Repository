---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---
<BaseLayout title="每日新聞匯入｜拾光誌">
  <main class="container admin-shell">
    <a class="text-link" href="/admin/news/">← 返回新聞管理</a>
    <div class="eyebrow" style="margin-top:28px">META AI DAILY IMPORT</div>
    <h1 class="serif">每日新聞匯入</h1>
    <p class="muted">將 Meta AI 每日產製的新聞貼在下方。支援依照指定格式輸出的多則新聞。</p>
    <div class="admin-panel">
      <label for="news-input"><strong>Meta AI 新聞內容</strong></label>
      <textarea id="news-input" rows="18" style="display:block;width:100%;margin-top:14px;padding:16px;border:1px solid var(--line);background:#fffefa;line-height:1.8;resize:vertical" placeholder="## 新聞 1

- 新聞標題：
- 新聞日期：
- 新聞分類：
- 新聞來源：
- 原始新聞網址：
- 新聞摘要：
- 詳細新聞整理：
- 重要關鍵字：

## 新聞 2
..."></textarea>
      <div class="row" style="display:flex;gap:12px;flex-wrap:wrap;margin-top:16px">
        <button class="button" id="parse-news" type="button">解析新聞內容</button>
        <button class="category-chip" id="clear-news" type="button">清空</button>
      </div>
      <p class="muted" style="font-size:12px">提醒：目前只在瀏覽器示範解析，不會儲存或公開發布。</p>
    </div>
    <section id="parse-results" class="admin-panel" hidden>
      <div class="section-heading"><h2 class="serif">解析結果</h2><span id="result-count" class="text-link"></span></div>
      <div id="result-list"></div>
      <button class="button" id="mock-publish" type="button">確認示範發布</button>
      <p class="muted" style="font-size:12px">正式版將在此處加入逐則編輯、重複檢查、草稿儲存及管理者確認發布。</p>
    </section>
  </main>
  <script>
    type ParsedNews = Record<string, string>;
    const input = document.querySelector<HTMLTextAreaElement>('#news-input');
    const results = document.querySelector<HTMLElement>('#parse-results');
    const list = document.querySelector<HTMLElement>('#result-list');
    const count = document.querySelector<HTMLElement>('#result-count');
    const parseButton = document.querySelector<HTMLButtonElement>('#parse-news');

    const normalizeEntities = (value: string) =>
      value.replace(/【entity-[^¦】]+¦canonical_name=([^】]+)】/g, '$1').trim();

    // Supports Meta AI's native title/date/category/source/url/summary/detail blocks,
    // separated by ---; also accepts the earlier Chinese Markdown template.
    const parseBlocks = (raw: string): ParsedNews[] => {
      const normalized = raw.replace(/\r\n/g, '\n').trim();
      const blocks = normalized.split(/^\s*---\s*$/m).map((part) => part.trim()).filter(Boolean);
      const aliases: Record<string, string> = {
        title: 'title', date: 'date', category: 'category', source: 'source',
        url: 'url', summary: 'summary', detail: 'detail', keywords: 'keywords',
        '新聞標題': 'title', '新聞日期': 'date', '新聞分類': 'category',
        '新聞來源': 'source', '原始新聞網址': 'url', '新聞摘要': 'summary',
        '詳細新聞整理': 'detail', '重要關鍵字': 'keywords'
      };
      return blocks.map((block) => {
        const fields: ParsedNews = {};
        let current = '';
        for (const line of block.split('\n')) {
          const match = line.match(/^\s*(?:[-*]\s*)?([^：:]+)[：:]\s*(.*)$/);
          const key = match ? aliases[match[1].trim()] : undefined;
          if (match && key) {
            current = key;
            fields[current] = normalizeEntities(match[2] || '');
          } else if (current && line.trim()) {
            fields[current] = (fields[current] ? fields[current] + '\n' : '') + normalizeEntities(line.trim());
          }
        }
        return fields;
      }).filter((item) => Object.keys(item).length > 0);
    };

    parseButton?.addEventListener('click', () => {
      const raw = input?.value.trim() ?? '';
      if (!raw) { alert('請先貼上 Meta AI 新聞內容。'); return; }
      const items = parseBlocks(raw);
      if (!items.length) {
        alert('無法辨識新聞格式。請確認每則新聞包含 title/date/category/source/url/summary/detail，並以 --- 分隔。');
        return;
      }
      if (list) list.innerHTML = '';
      let valid = 0;
      let warnings = 0;
      items.forEach((item, index) => {
        const missing = ['title','date','category','source','url','summary','detail'].filter((key) => !item[key]?.trim());
        const parsedUrl = item.url ? (() => { try { return new URL(item.url); } catch { return null; } })() : null;
        const urlValid = !!parsedUrl && ['http:', 'https:'].includes(parsedUrl.protocol);
        const suspiciousUrl = !!parsedUrl && (parsedUrl.pathname.includes('/admin/') || parsedUrl.hostname === 'example.com');
        const isOverview = /總覽|每日新聞摘要/.test(item.category || '') || /最具影響力新聞摘要/.test(item.title || '');
        const issues = [...missing.map((key) => '缺少 ' + key)];
        if (item.url && !urlValid) issues.push('網址格式不正確');
        if (suspiciousUrl) issues.push('網址看起來不是原始新聞報導頁，請確認');
        if (isOverview) issues.push('這是每日總覽資料，建議作為新聞專題導言，不要與單則新聞混在一起');
        if (issues.length) warnings++;

        const card = document.createElement('article');
        card.className = 'admin-panel';
        const title = document.createElement('h3');
        title.textContent = item.title || '（缺少新聞標題）';
        const info = document.createElement('p');
        info.className = 'muted';
        info.textContent = [item.date, item.category, item.source].filter(Boolean).join(' · ');
        const summary = document.createElement('p');
        summary.textContent = item.summary || '缺少摘要';
        const status = document.createElement('p');
        status.className = issues.length ? 'muted' : 'eyebrow';
        status.textContent = issues.length ? '需要檢查：' + issues.join('；') : '必要欄位完整（仍須人工核對新聞事實與來源）';
        const detail = document.createElement('details');
        const summaryLabel = document.createElement('summary');
        summaryLabel.textContent = '查看詳細整理';
        const detailText = document.createElement('p');
        detailText.textContent = item.detail || '尚無詳細內容';
        detail.append(summaryLabel, detailText);
        card.append(title, info, summary, status, detail);
        list?.append(card);
        if (!missing.length && urlValid && !suspiciousUrl && !isOverview) valid++;
      });
      if (count) count.textContent = '辨識 ' + items.length + ' 個區塊 · 可進入下一步 ' + valid + ' 則 · 需檢查 ' + warnings + ' 個區塊';
      if (results) results.hidden = false;
      results?.scrollIntoView({behavior:'smooth',block:'start'});
    });

    document.querySelector('#clear-news')?.addEventListener('click', () => {
      if (input) input.value = '';
      if (results) results.hidden = true;
      if (list) list.innerHTML = '';
    });
    document.querySelector('#mock-publish')?.addEventListener('click', () =>
      alert('這是 UI 原型：目前不會寫入資料庫或發布到公開網站。正式版會先儲存草稿，經人工確認後才發布。')
    );
  </script>t>
</BaseLayout>
