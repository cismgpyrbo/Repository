---
import BaseLayout from '../../../layouts/BaseLayout.astro';
const supabaseUrl = 'https://aaynitbvfhxttrmlmvlf.supabase.co';
const publishableKey = 'sb_publishable_NboWNFpuMgsFAP0j-_3keg_jQIGLI2a';
---
<BaseLayout title="新聞管理｜拾光誌">
  <main class="container admin-shell">
    <div class="eyebrow">NEWS MANAGEMENT</div>
    <h1 class="serif">新聞管理</h1>
    <p class="muted">管理每日新聞摘要與新聞文章。每日摘要由排程產生後寫入 Supabase，發布內容會同步顯示於公開網站。</p>
    <div class="admin-stats">
      <div class="stat"><span class="muted">全部新聞</span><strong id="stat-total">—</strong></div>
      <div class="stat"><span class="muted">已發布</span><strong id="stat-published">—</strong></div>
      <div class="stat"><span class="muted">待審核／草稿</span><strong id="stat-draft">—</strong></div>
    </div>
    <div class="admin-panel">
      <div class="section-heading"><h2 class="serif">每日新聞</h2><a class="button" href="/admin/news/import/">＋ 匯入新聞</a></div>
      <p id="admin-news-status" class="muted">正在讀取 Supabase 新聞資料…</p>
      <div style="overflow-x:auto">
        <table class="admin-table">
          <thead><tr><th>標題</th><th>日期</th><th>分類</th><th>類型</th><th>狀態</th><th>公開頁面</th></tr></thead>
          <tbody id="admin-news-rows"></tbody>
        </table>
      </div>
    </div>
  </main>
</BaseLayout>

<script is:inline type="module" define:vars={{ supabaseUrl, publishableKey, basePath: import.meta.env.BASE_URL }}>
  import { createClient } from 'https://esm.sh/@supabase/supabase-js@2.57.0';
  const supabase = createClient(supabaseUrl, publishableKey);
  const base = basePath.endsWith('/') ? basePath : basePath + '/';
  const rows = document.getElementById('admin-news-rows');
  const status = document.getElementById('admin-news-status');

  const cell = (value) => {
    const td = document.createElement('td');
    td.textContent = value ?? '';
    return td;
  };

  try {
    const { data, error } = await supabase
      .from('blog_news_articles')
      .select('title,slug,news_date,category,status,content_type,published_at')
      .order('news_date', { ascending: false })
      .order('created_at', { ascending: false });
    if (error) throw error;

    const articles = data ?? [];
    document.getElementById('stat-total').textContent = String(articles.length);
    document.getElementById('stat-published').textContent = String(articles.filter((item) => item.status === 'published').length);
    document.getElementById('stat-draft').textContent = String(articles.filter((item) => item.status === 'draft').length);
    status.textContent = '已連線 Supabase，共讀取 ' + articles.length + ' 筆新聞。';

    rows.replaceChildren();
    if (!articles.length) {
      const tr = document.createElement('tr');
      const td = cell('目前尚無新聞資料；每日摘要發布後會出現在此列表。');
      td.colSpan = 6;
      tr.append(td);
      rows.append(tr);
    } else {
      articles.forEach((item) => {
        const tr = document.createElement('tr');
        tr.append(
          cell(item.title),
          cell(item.news_date),
          cell(item.category),
          cell(item.content_type === 'daily_briefing' ? '每日摘要' : '單則新聞'),
          cell(item.status === 'published' ? '已發布' : item.status === 'draft' ? '草稿' : '已封存')
        );
        const td = document.createElement('td');
        if (item.status === 'published') {
          const a = document.createElement('a');
          a.className = 'text-link';
          a.href = base + 'news/?slug=' + encodeURIComponent(item.slug);
          a.textContent = '查看';
          td.append(a);
        } else {
          td.textContent = '尚未公開';
        }
        tr.append(td);
        rows.append(tr);
      });
    }
  } catch (error) {
    status.textContent = '新聞資料載入失敗：' + (error?.message || '未知錯誤');
  }
</script>
