---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="管理者登入｜拾光誌">
  <main class="container admin-shell" style="max-width:560px">
    <div class="eyebrow">ADMINISTRATOR ACCESS</div>
    <h1 class="serif">管理者登入</h1>
    <p class="muted">此頁僅供已建立管理者帳號且已加入拾光誌管理者名單的人員使用。</p>
    <form id="admin-login-form" class="admin-panel" style="display:grid;gap:16px">
      <label for="email">電子郵件</label>
      <input id="email" name="email" type="email" autocomplete="username" required style="padding:13px;border:1px solid var(--line);background:#fffefa" />
      <label for="password">密碼</label>
      <input id="password" name="password" type="password" autocomplete="current-password" required style="padding:13px;border:1px solid var(--line);background:#fffefa" />
      <button class="button" id="login-submit" type="submit">登入管理後台</button>
      <p id="login-message" class="muted" role="status" aria-live="polite"></p>
    </form>
    <p class="muted" style="font-size:13px">網站不開放訪客自行註冊。若帳號無法登入，請先確認 Supabase Auth 使用者已確認 Email，且已加入 blog_admins 管理者名單。</p>
    <a class="text-link" href="/">← 返回拾光誌首頁</a>
  </main>
  <script is:inline type="module" define:vars={{ basePath: import.meta.env.BASE_URL }}>
    import { createClient } from 'https://esm.sh/@supabase/supabase-js@2.119.2';
    const supabase = createClient('https://aaynitbvfhxttrmlmvlf.supabase.co', 'sb_publishable_NboWNFpuMgsFAP0j-_3keg_jQIGLI2a', {
      auth: { persistSession: true, autoRefreshToken: true, detectSessionInUrl: true }
    });
    const root = (basePath.endsWith('/') ? basePath.slice(0, -1) : basePath);
    const form = document.querySelector('#admin-login-form');
    const message = document.querySelector('#login-message');
    const submit = document.querySelector('#login-submit');
    const params = new URLSearchParams(location.search);
    const requested = params.get('next');
    const nextPath = requested && requested.startsWith(root + '/admin') && !requested.includes('://')
      ? requested : root + '/admin/';
    const showMessage = (text, error = false) => {
      if (message) {
        message.textContent = text;
        message.style.color = error ? '#a33b32' : '';
      }
    };

    // Existing sessions are still checked against the database allowlist.
    const { data: sessionData } = await supabase.auth.getSession();
    if (sessionData.session) {
      const { data: admin, error } = await supabase
        .from('blog_admins').select('user_id')
        .eq('user_id', sessionData.session.user.id).maybeSingle();
      if (admin && !error) location.replace(nextPath);
    }

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (submit) submit.disabled = true;
      showMessage('正在驗證帳號…');
      const email = document.querySelector('#email')?.value?.trim() ?? '';
      const password = document.querySelector('#password')?.value ?? '';
      try {
        const { data, error } = await supabase.auth.signInWithPassword({ email, password });
        if (error) throw error;
        if (!data.user) throw new Error('登入未完成，請重新操作。');
        const { data: admin, error: adminError } = await supabase
          .from('blog_admins').select('user_id')
          .eq('user_id', data.user.id).maybeSingle();
        if (adminError) throw adminError;
        if (!admin) {
          await supabase.auth.signOut();
          throw new Error('此帳號尚未取得拾光誌管理者權限。');
        }
        showMessage('登入成功，正在進入管理後台…');
        location.replace(nextPath);
      } catch (error) {
        showMessage(error instanceof Error ? error.message : '登入失敗，請稍後再試。', true);
      } finally {
        if (submit) submit.disabled = false;
      }
    });
  </script>
</BaseLayout>
