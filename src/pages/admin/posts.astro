    .form-field textarea{line-height:1.8;resize:vertical}
    .editor-toolbar{display:flex;flex-wrap:wrap;gap:7px;padding:9px;background:#f2f2ec;border:1px solid var(--line);border-bottom:0}
    .editor-toolbar button{border:1px solid #d8d9cf;background:#fffefa;color:#34433a;border-radius:4px;padding:7px 10px;font:inherit;font-size:12px;cursor:pointer}
    .editor-toolbar button:hover{background:#e8eee7}
    #post-content{border-radius:0 0 5px 5px;font-family:ui-monospace,SFMono-Regular,Consolas,monospace;font-size:13px}
    .editor-help{font-size:11px;color:var(--muted)}
    .content-preview-panel{border:1px solid var(--line);padding:18px;background:#fffefa}
    .preview-label{font-size:11px;letter-spacing:.12em;color:var(--muted);margin-bottom:15px}
    .content-preview-panel .article-body{line-height:1.9;overflow-wrap:anywhere}
    .content-preview-panel .article-body :global(img){max-width:100%;height:auto}
    .content-preview-panel .article-body :global(table){width:100%;border-collapse:collapse;margin:18px 0}
    .content-preview-panel .article-body :global(th),.content-preview-panel .article-body :global(td){border:1px solid var(--line);padding:8px;text-align:left}
    .media-picker-dialog{width:min(760px,calc(100% - 24px));max-height:85vh;border:1px solid var(--line);padding:18px;background:#fffefa;color:#26342d}
    .media-picker-dialog::backdrop{background:#18231dcc}
    .media-picker-head{display:flex;justify-content:space-between;align-items:flex-start;gap:12px}
    .media-picker-head h2{margin:0}.media-picker-head p{font-size:12px;color:var(--muted);margin:5px 0 14px}
    #media-picker-search{width:100%;padding:10px;border:1px solid var(--line);margin-bottom:12px}
    .media-picker-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(110px,1fr));gap:10px;max-height:48vh;overflow:auto}
    :global(.media-picker-item){min-width:0;border:1px solid var(--line);padding:6px;background:#fff;text-align:left;cursor:pointer}
    :global(.media-picker-item img){display:block;width:100%;height:90px;object-fit:contain;background:#f0f0eb}
    :global(.media-picker-item span){display:block;font-size:11px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-top:5px}
    .form-field small{font-size:11px;color:var(--muted)}
    .form-check{display:flex;align-items:center;gap:9px;font-size:13px}
    .form-actions{display:flex;align-items:center;gap:14px;flex-wrap:wrap}
    .form-actions .button{margin-top:0}
    .category-create{display:grid;grid-template-columns:1fr 1fr auto;gap:12px;align-items:end;margin-bottom:18px}
    .category-create .button{margin:0;white-space:nowrap}
    .table-scroll{overflow-x:auto}
    .danger-link{color:#a33b32}
    [hidden]{display:none!important}
    @media(max-width:700px){.form-grid,.category-create{grid-template-columns:1fr}.form-span-2{grid-column:auto}.section-heading{align-items:flex-start;gap:12px;flex-direction:column}}
  </style>
</BaseLayout>
